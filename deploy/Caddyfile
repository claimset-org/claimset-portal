{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip

	# Published files are static: served from the published directory without touching the app.
	@published path /p/* /index.jsonl /llms.txt
	handle @published {
		root * /srv/published
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy app:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
