# Copy to .env and edit. .env is never committed.

# The domain Caddy serves and gets a certificate for. "localhost" for local development.
PORTAL_DOMAIN=localhost

# Password of the database user "portal". Use a long random value in production.
POSTGRES_PASSWORD=change-me

# development or production
PORTAL_ENV=development

# The registry clone and its commit identity
PORTAL_GIT_NAME=LibLM
PORTAL_GIT_EMAIL=registry@liblm.invalid

# OpenAlex API key, used only to build the classifier image (a free key: openalex.org/settings/api)
OPENALEX_API_KEY=

# ORCID sign-in for consent. Register a client (sandbox.orcid.org for testing, orcid.org in production) with the
# redirect URI <PORTAL_BASE_URL>/consent/callback.
ORCID_BASE=https://sandbox.orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
